# ─── QuickBooks Online (developer.intuit.com) ────────────────────────────────
QB_CLIENT_ID=your_client_id_here
QB_CLIENT_SECRET=your_client_secret_here
QB_REDIRECT_URI=http://localhost:8501/callback
QB_ENVIRONMENT=sandbox          # sandbox | production

# ─── LiteLLM Backend ─────────────────────────────────────────────────────────
# Ollama (local dev):
LITELLM_MODEL=ollama/llama3.2
LITELLM_API_BASE=http://localhost:11434

# When your private LLM is ready, swap these two lines:
# LITELLM_MODEL=openai/your-model-name
# LITELLM_API_BASE=https://your-litellm-gateway.example.com
# LITELLM_API_KEY=your_gateway_key

# ─── App ─────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-32-char-string
DB_PATH=./data/qb_data.db
TOKEN_PATH=./data/qb_tokens.json
